PORT=3000
HOST=127.0.0.1
SITE_URL=http://localhost:3000
# Caminho privado: nunca colocar dentro de public/.
DATABASE_PATH=./data/contacts.sqlite
# Para produção: configurar domínio HTTPS em SITE_URL e proxy com TLS.
# Formulários SQLite não enviam e-mail; notificações do chatbot estão abaixo.
# Chatbot: server-only secrets. Never publish these values in public/ or HTML.
CHAT_API_URL=
CHAT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=https://pumofujrevwzbjdmqmrl.supabase.co
SUPABASE_SECRET_KEY=
CHAT_SESSION_SECRET=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_ENABLED=false
# IA direta OpenAI: manter a chave somente no servidor.
CHAT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Notificações administrativas dos pedidos do bot (somente no servidor).
EMAIL_HOOK_SECRET=
RESEND_API_KEY=
# resend.dev só permite enviar para o e-mail da própria conta Resend.
REQUEST_EMAIL_DOMAIN=resend.dev
